---
interface Score {
  subject: string;
  score: number;
  full_score: number;
  date: string;
  class_rank?: number | null;
  class_size?: number | null;
}
interface Props {
  subjects: string[];
  scores: Score[];
}
const { subjects, scores } = Astro.props;

const PALETTE = ['#c25a2a', '#2f7d32', '#2a6cc2', '#8e3ec2', '#c08515', '#0d8e8e', '#c2336f', '#5a6072'];
const W = 760, H = 280, P = { t: 22, r: 18, b: 32, l: 40 };
const innerW = W - P.l - P.r;
const innerH = H - P.t - P.b;

const dates = Array.from(new Set(scores.map((s) => s.date))).sort();
const xMax = Math.max(dates.length - 1, 1);
const yMin = 0, yMax = 100;
const xAt = (i: number) => P.l + (i / xMax) * innerW;
const yAt = (v: number) => P.t + (1 - (v - yMin) / (yMax - yMin)) * innerH;

// 班级中位分估算: class_rank/class_size 占比 → 把"我离班级中位的分差"压到 ±30 分范围
function medianOffset(p: Score): number | null {
  if (!p.class_rank || !p.class_size || p.class_size < 2) return null;
  const pct = (p.class_size / 2 - p.class_rank) / p.class_size; // -0.5 ~ +0.5
  return pct * 60; // 班级中位 ≈ 我的分 + offset
}
function medianScore(p: Score): number | null {
  const off = medianOffset(p);
  return off == null ? null : p.score + off;
}

// 移动平均(窗口 3)
function ma(pts: (number | null)[]): (number | null)[] {
  return pts.map((_, i) => {
    const win = pts.slice(Math.max(0, i - 2), i + 1).filter((v): v is number => v != null);
    if (!win.length) return null;
    return win.reduce((a, b) => a + b, 0) / win.length;
  });
}

function buildPath(vals: (number | null)[]) {
  return vals
    .map((v, i) => (v == null ? null : `${i === 0 || vals[i - 1] == null ? 'M' : 'L'} ${xAt(i).toFixed(1)} ${yAt(v).toFixed(1)}`))
    .filter(Boolean)
    .join(' ');
}

const grid = [0, 25, 50, 75, 100];
---
<svg viewBox={`0 0 ${W} ${H}`} style="width:100%;height:auto;display:block;" role="img" aria-label="成绩趋势图">
  {/* Y 网格 */}
  {grid.map((v) => (
    <g>
      <line x1={P.l} x2={W - P.r} y1={yAt(v)} y2={yAt(v)} stroke="var(--line)" stroke-dasharray={v === 0 ? '0' : '2 3'} />
      <text x={P.l - 6} y={yAt(v) + 3} text-anchor="end" font-size="11" fill="var(--fg-muted)">{v}</text>
    </g>
  ))}
  {/* X 标签 */}
  {dates.map((d, i) => (
    <text x={xAt(i)} y={H - P.b + 14} text-anchor="middle" font-size="10" fill="var(--fg-muted)">{d.slice(5)}</text>
  ))}

  {/* 班级中位虚线 (按科目各自画) */}
  {subjects.map((subj, si) => {
    const vals = dates.map((d) => {
      const p = scores.find((s) => s.subject === subj && s.date === d);
      return p ? medianScore(p) : null;
    });
    if (vals.every((v) => v == null)) return null;
    return (
      <path
        d={buildPath(vals)}
        stroke={PALETTE[si % PALETTE.length]}
        stroke-width="1"
        stroke-dasharray="2 4"
        opacity="0.4"
        fill="none"
      />
    );
  })}

  {/* 折线 (各科) */}
  {subjects.map((subj, si) => {
    const vals = dates.map((d) => scores.find((s) => s.subject === subj && s.date === d)?.score ?? null);
    return <path d={buildPath(vals)} stroke={PALETTE[si % PALETTE.length]} stroke-width="2" fill="none" stroke-linejoin="round" stroke-linecap="round" />;
  })}

  {/* 移动平均虚线 (各科, 3 点) */}
  {subjects.map((subj, si) => {
    const vals = dates.map((d) => scores.find((s) => s.subject === subj && s.date === d)?.score ?? null);
    const maVals = ma(vals);
    return <path d={buildPath(maVals)} stroke={PALETTE[si % PALETTE.length]} stroke-width="1.5" stroke-dasharray="5 2" fill="none" opacity="0.85" />;
  })}

  {/* 数据点 + delta 标签 (各科最近两点) */}
  {subjects.map((subj, si) => {
    const color = PALETTE[si % PALETTE.length];
    const pts = dates.map((d) => scores.find((s) => s.subject === subj && s.date === d));
    return (
      <g>
        {pts.map((p, di) => {
          if (!p) return null;
          // 评分阈值: ⭐>=90, 良>=75, 待提升<60, 一般其他
          const tier = p.score >= 90 ? 'star' : p.score >= 75 ? 'good' : p.score < 60 ? 'bad' : 'mid';
          const r = tier === 'star' ? 5 : 3;
          return (
            <g>
              <circle cx={xAt(di)} cy={yAt(p.score)} r={r + 2} fill={color} opacity="0.18" />
              <circle cx={xAt(di)} cy={yAt(p.score)} r={r} fill={color} stroke={tier === 'star' ? '#d4a017' : tier === 'bad' ? '#b3331f' : 'none'} stroke-width={tier === 'star' || tier === 'bad' ? 1.5 : 0} />
              {tier === 'star' && (
                <text x={xAt(di)} y={yAt(p.score) - 10} text-anchor="middle" font-size="9" fill="#d4a017">⭐</text>
              )}
            </g>
          );
        })}
        {pts.length >= 2 && pts.at(-1)!.score != null && pts.at(-2)!.score != null && (() => {
          const last = pts.at(-1)!;
          const prev = pts.at(-2)!;
          const d = last.score - prev.score;
          const sign = d > 0 ? '+' : '';
          const color = d > 0 ? 'var(--good)' : d < 0 ? 'var(--bad)' : 'var(--fg-muted)';
          return <text x={xAt(pts.length - 1)} y={yAt(last.score) - 8} text-anchor="middle" font-size="10" font-weight="600" fill={color}>{sign}{d}</text>;
        })()}
      </g>
    );
  })}
</svg>
{/* 图例 */}
<div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:8px;font-size:12px;color:var(--fg);">
  {subjects.map((subj, si) => (
    <span style="display:inline-flex;align-items:center;gap:6px;">
      <span style={`width:10px;height:3px;background:${PALETTE[si % PALETTE.length]};border-radius:2px;`}></span>
      {subj}
    </span>
  ))}
  <span style="display:inline-flex;align-items:center;gap:6px;color:var(--fg-muted);">
    <span style="width:14px;border-top:1.5px dashed currentColor;display:inline-block;"></span> 3 点移动平均
  </span>
  <span style="display:inline-flex;align-items:center;gap:6px;color:var(--fg-muted);">
    <span style="width:14px;border-top:1px dashed currentColor;display:inline-block;"></span> 班级中位估算
  </span>
  <span style="display:inline-flex;align-items:center;gap:4px;color:#d4a017;">⭐ ≥90 优秀</span>
</div>
