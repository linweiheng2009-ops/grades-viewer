---
interface Props {
  title?: string;
  active?: 'home' | 'import' | 'settings';
}
const { title = '成绩看板', active = 'home' } = Astro.props;
const navItems = [
  { key: 'home', href: '/', label: '看板' },
  { key: 'import', href: '/import', label: '导入' },
  { key: 'settings', href: '/settings', label: '设置' },
] as const;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #fdfaf6;
        --fg: #2b2118;
        --fg-muted: #7a6e62;
        --accent: #c25a2a;
        --accent-soft: #fbe8db;
        --card: #ffffff;
        --line: #ebe1d4;
        --good: #2f7d32;
        --warn: #c08515;
        --bad: #b3331f;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1b1612;
          --fg: #f1e8db;
          --fg-muted: #a89886;
          --accent: #e08958;
          --accent-soft: #3a2a1f;
          --card: #25201b;
          --line: #3a3128;
          --good: #6fbf6f;
          --warn: #e0b15c;
          --bad: #e57a6b;
        }
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.55;
        font-size: 15px;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      button {
        font: inherit;
        cursor: pointer;
        border: 1px solid var(--line);
        background: var(--card);
        color: var(--fg);
        padding: 8px 14px;
        border-radius: 8px;
      }
      button:hover { background: var(--accent-soft); }
      input, textarea, select {
        font: inherit;
        background: var(--card);
        color: var(--fg);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 6px 10px;
      }
      .container { max-width: 980px; margin: 0 auto; padding: 0 20px; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 18px; }
      .muted { color: var(--fg-muted); font-size: 13px; }
      h1, h2, h3 { margin: 0 0 12px; line-height: 1.25; }
      h1 { font-size: 24px; }
      h2 { font-size: 18px; }

      /* 移动端响应式 */
      @media (max-width: 640px) {
        body { font-size: 14px; }
        h1 { font-size: 20px; }
        h2 { font-size: 16px; }
        .container { padding: 0 12px; }
        main.container { padding: 16px 12px 48px !important; }
        .card { padding: 14px; border-radius: 10px; }
        nav > .container { gap: 12px !important; height: auto !important; min-height: 52px; padding-top: 8px; padding-bottom: 8px; flex-wrap: wrap; }
        nav > .container > span { display: none; }
        table { font-size: 12px; }
        table th, table td { padding: 6px 4px !important; }
        textarea { font-size: 11px !important; }
        .responsive-2col { grid-template-columns: 1fr !important; }
      }
    </style>
  </head>
  <body>
    <nav style="border-bottom:1px solid var(--line); background:var(--card);">
      <div class="container" style="display:flex;align-items:center;gap:24px;height:52px;">
        <a href="/" style="font-weight:600;color:var(--fg);">📊 成绩看板</a>
        <div style="display:flex;gap:6px;">
          {navItems.map((it) => (
            <a href={it.href} style={`padding:6px 12px;border-radius:6px;color:${active === it.key ? 'var(--accent)' : 'var(--fg)'};background:${active === it.key ? 'var(--accent-soft)' : 'transparent'};font-size:14px;`}>
              {it.label}
            </a>
          ))}
        </div>
        <span style="margin-left:auto;font-size:12px;color:var(--fg-muted);">本地版 · 离线可用</span>
      </div>
    </nav>
    <main class="container" style="padding:24px 20px 64px;">
      <slot />
    </main>
  </body>
</html>
