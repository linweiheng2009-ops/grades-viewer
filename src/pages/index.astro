---
import Base from '../layouts/Base.astro';
import { listStudents, listScoresForStudent, getDb, ensureSchema } from '../lib/repo';
const url = new URL(Astro.request.url);
const justCreated = url.searchParams.get('created');

const db = await getDb(Astro);
await ensureSchema(db);

const students = await listStudents(db);
const totalExams = (await db.prepare('SELECT COUNT(*) AS n FROM exams').first<any>())?.n ?? 0;
const totalScores = (await db.prepare('SELECT COUNT(*) AS n FROM subject_scores').first<any>())?.n ?? 0;
const totalComments = (await db.prepare('SELECT COUNT(*) AS n FROM ai_comments').first<any>())?.n ?? 0;
const lastImport = (await db.prepare("SELECT MAX(created_at) AS d FROM exams").first<any>())?.d ?? null;
const globalAvg = (() => {
  if (!totalScores) return null;
  const r = db.prepare('SELECT AVG(score) AS a FROM subject_scores').first<any>();
  return r ? Math.round((r.a ?? 0) as number) : null;
})();

type Row = {
  id: string; name: string; avatar: string | null; grade: string | null; school: string | null;
  examCount: number; avgScore: number | null; latestDate: string | null; trend: number | null;
};
const studentRows: Row[] = await Promise.all(students.map(async (s) => {
  const scores = await listScoresForStudent(db, s.id);
  const examCount = new Set(scores.map((x) => x.date)).size;
  const all = scores.map((x) => x.score);
  const avgScore = all.length ? Math.round(all.reduce((a, b) => a + b, 0) / all.length) : null;
  const dates = Array.from(new Set(scores.map((x) => x.date))).sort();
  const latest = dates.at(-1) ?? null;
  const prev = dates.at(-2) ?? null;
  let trend: number | null = null;
  if (latest && prev) {
    const a = scores.filter((x) => x.date === latest).reduce((s, x) => s + x.score, 0) /
              Math.max(1, scores.filter((x) => x.date === latest).length);
    const b = scores.filter((x) => x.date === prev).reduce((s, x) => s + x.score, 0) /
              Math.max(1, scores.filter((x) => x.date === prev).length);
    trend = Math.round(a - b);
  }
  return { id: s.id, name: s.name, avatar: s.avatar, grade: s.grade, school: s.school,
           examCount, avgScore, latestDate: latest, trend };
}));
---
<Base title="成绩看板" active="home">
  {justCreated && (
    <div class="card" style="margin-bottom:16px;border-color:var(--good);background:var(--accent-soft);">
      ✅ 学生已创建 · <a href={`/student/${justCreated}`}>立即查看 →</a>
    </div>
  )}

  <div class="stat-grid">
    <div class="card stat-card">
      <div class="stat-label">学生</div>
      <div class="stat-value">{students.length}</div>
    </div>
    <div class="card stat-card">
      <div class="stat-label">考试场次</div>
      <div class="stat-value">{totalExams}</div>
      <div class="stat-sub">{totalScores} 条科目分数</div>
    </div>
    <div class="card stat-card">
      <div class="stat-label">总均分</div>
      <div class="stat-value">{globalAvg ?? '—'}</div>
      <div class="stat-sub">{totalComments} 条 AI 评语</div>
    </div>
    <div class="card stat-card">
      <div class="stat-label">最近导入</div>
      <div class="stat-value" style="font-size:18px;">{lastImport ? lastImport.slice(0, 10) : '—'}</div>
      <div class="stat-sub">{lastImport ? lastImport.slice(11, 16) : '尚无'}</div>
    </div>
  </div>

  <div style="display:flex;align-items:baseline;gap:12px;margin:24px 0 14px;">
    <h1 style="margin:0;font-size:20px;">学生</h1>
    <span class="muted">{students.length} 位</span>
  </div>

  {students.length === 0 ? (
    <div class="card" style="text-align:center;padding:48px 24px;">
      <p style="font-size:18px;margin:0 0 12px;">还没有学生</p>
      <p class="muted" style="margin:0 0 20px;">先添加一个学生,然后导入成绩 CSV 即可生成趋势看板。</p>
    </div>
  ) : (
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;margin-bottom:32px;">
      {studentRows.map((s) => (
        <a href={`/student/${s.id}`} class="card student-card">
          <div style="display:flex;align-items:center;gap:12px;">
            <div class="avatar">{s.avatar || s.name[0]}</div>
            <div style="flex:1;min-width:0;">
              <div style="font-weight:600;font-size:16px;">{s.name}</div>
              <div class="muted" style="font-size:12px;">{s.grade ?? '—'} {s.school && `· ${s.school}`}</div>
            </div>
          </div>
          <div style="display:flex;gap:14px;margin-top:12px;font-size:13px;">
            <div><span class="muted">均分</span> <strong>{s.avgScore ?? '—'}</strong></div>
            <div><span class="muted">考试</span> <strong>{s.examCount}</strong></div>
            {s.trend != null && s.trend !== 0 && (
              <div>
                <span class="muted">最近</span>
                <strong style={`color:${s.trend > 0 ? 'var(--good)' : 'var(--bad)'};`}>
                  {s.trend > 0 ? '+' : ''}{s.trend}
                </strong>
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  )}

  <div class="card">
    <h2 style="margin-top:0;">添加学生</h2>
    <form method="post" action="/api/student" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;">
      <label>姓名<input name="name" required maxlength="32" /></label>
      <label>年级<input name="grade" placeholder="三年级" maxlength="16" /></label>
      <label>学校<input name="school" placeholder="可选" maxlength="48" /></label>
      <label>头像 emoji<input name="avatar" placeholder="🧒" maxlength="4" /></label>
      <label style="grid-column:1/-1;display:flex;gap:8px;align-items:center;">
        <button type="submit">添加</button>
        <span class="muted">数据存 D1 (云端 SQLite)</span>
      </label>
    </form>
  </div>
</Base>

<style>
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    margin-bottom: 8px;
  }
  .stat-card { padding: 14px 16px; }
  .stat-label { font-size: 12px; color: var(--fg-muted); margin-bottom: 4px; }
  .stat-value { font-size: 28px; font-weight: 700; line-height: 1.2; }
  .stat-sub { font-size: 11px; color: var(--fg-muted); margin-top: 2px; }
  .student-card {
    display: block;
    color: inherit;
    text-decoration: none;
    transition: transform .15s, border-color .15s;
  }
  .student-card:hover { transform: translateY(-1px); border-color: var(--accent); }
  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
  }
</style>
